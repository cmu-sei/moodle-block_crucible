<div class="crucible-card crucible-competency-detail">
  <div class="crucible-card__header">
    <div class="crucible-card__icon">🏷️</div>
    <div class="crucible-card__titlewrap">
      <div class="crucible-card__title">{{{cardtitle}}}</div>
    </div>
  </div>

  <div class="crucible-card__body">
    {{#groups}}
      <div class="crucible-competency-framework-group">
        <h2 class="crucible-competency-framework-group__heading">
          <a href="{{url}}">{{framework}}</a>
        </h2>
        {{#name}}<div class="crucible-competency-framework-group__meta">{{{name}}}</div>{{/name}}
        {{> block_crucible/competency_panels }}
      </div>
    {{/groups}}
  </div>
</div>
